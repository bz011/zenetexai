# ============================================================================
# SUPABASE Configuration (Required)
# ============================================================================

# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only (NEVER expose to client)
# Keep this secret - do NOT commit to Git
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# APP Configuration
# ============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================================================
# STRIPE Configuration (Phase 1 preparation - not used yet)
# ============================================================================

# Get these from Stripe Dashboard after setup
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# AI / LLM Configuration (Phase 2 only)
# ============================================================================

# OPENAI_API_KEY=sk_...  # Uncomment in Phase 2

# ============================================================================
# NOTES
# ============================================================================

# 1. Copy this file to .env.local (Git-ignored)
# 2. Fill in values from Supabase Dashboard
# 3. For SUPABASE_SERVICE_ROLE_KEY:
#    - Go to Settings → API → Project API Keys
#    - Copy "service_role" key
#    - Keep it SECRET - only for server-side operations
# 4. Never commit .env.local to Git
# 5. Public keys (NEXT_PUBLIC_*) are safe to commit
